#!/usr/bin/env bash
# One setup command for a fresh checkout: `./scripts/setup`
# 1. Installs mise MISE_VERSION when no mise is on PATH (checksum checked).
# 2. Installs the tools pinned in mise.toml at the versions in mise.lock.
# 3. Installs the npm packages in package-lock.json (`npm ci`).
# Safe to run again. It never deploys, publishes or changes pins or lockfiles.
set -euo pipefail
cd "$(dirname "$0")/.."

MISE_VERSION=2026.10.0
if ! command -v mise >/dev/null 2>&1; then
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) platform=linux-x64 sum=6ae3d2bda39cca86713501317edf623b59b75cd8afa2e31c20b1ee6500b4b739 ;;
    Linux-aarch64 | Linux-arm64) platform=linux-arm64 sum=107c5e46693cdfeb1fdec91717078b298d6fcc9ebbd14f8333917cfe37965138 ;;
    Darwin-arm64) platform=macos-arm64 sum=e6a966e44f871403df905d50019ca6f7b84624ddfe1d5c095f5bc3f18709259e ;;
    Darwin-x86_64) platform=macos-x64 sum=6bb6c2239b8990c81350d4f9e46bfffd6cfaf48f967b2f98963ce24b944400f0 ;;
    *) echo "setup: unsupported system $(uname -s) $(uname -m)" >&2; exit 1 ;;
  esac
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  curl -fsSL -o "$tmp/mise.tar.gz" \
    "https://github.com/jdx/mise/releases/download/v$MISE_VERSION/mise-v$MISE_VERSION-$platform.tar.gz"
  if command -v sha256sum >/dev/null 2>&1; then actual=$(sha256sum "$tmp/mise.tar.gz"); else actual=$(shasum -a 256 "$tmp/mise.tar.gz"); fi
  if [ "${actual%% *}" != "$sum" ]; then echo "setup: mise download checksum mismatch" >&2; exit 1; fi
  tar -xzf "$tmp/mise.tar.gz" -C "$tmp"
  mkdir -p "$HOME/.local/bin"
  install -m 0755 "$tmp/mise/bin/mise" "$HOME/.local/bin/mise"
  export PATH="$HOME/.local/bin:$PATH"
  echo "setup: installed mise $MISE_VERSION in ~/.local/bin"
fi

mise trust --quiet mise.toml
mise install --locked
mise exec -- npm ci --no-audit --no-fund
