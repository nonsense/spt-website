{
  "name": "spt-fyi-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static website for Simple Public Transit at spt.fyi",
  "homepage": "https://spt.fyi",
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "preview": "npm run build && wrangler pages dev dist --port 8788",
    "deploy": "npm run deploy:site",
    "deploy:site": "node scripts/deploy.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy:data": "node scripts/deploy-data.mjs",
    "deploy:all": "npm run deploy:data && npm run deploy:site",
    "deploy:preview": "node scripts/deploy.mjs --preview"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents@2.3.3": false
  }
}
